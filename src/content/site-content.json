  "texts": {},
  "philosophy": {
    "mission": "Summon worlds that eat reality.",
    "vision": "To be remembered not for noise, but for depth.",
    "valuesIntro": "Four rules govern every project, ours or a partner's. They are written down, reviewed at every milestone, and owned by a named lead.",
    "values": [
      {
        "title": "Design thinking",
        "text": "Every feature begins as a question about the player. We prototype, playtest, then produce."
      },
      {
        "title": "Cost consciousness",
        "text": "Budgets are set per milestone and tracked weekly. A lean core and an on-call roster. No idle bench."
      },
      {
        "title": "Strict governance",
        "text": "Decision rights, milestone gates and transparent reporting, agreed before work begins."
      },
      {
        "title": "Discipline",
        "text": "Scope is a design constraint. We finish what we start, on the timeline we agreed."
      }
    ],
    "doc": "Craft is the foundation. Authorship creates accountability. Every frame must carry weight."
  },
  "production": {
